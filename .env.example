# ── Frontend (Next.js) ──
# For local development with backend running on port 5000:
NEXT_PUBLIC_API_URL=http://localhost:5000

# For Vercel deployment, set this to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# ── Backend (Express server in /server) ──
# Copy these to server/.env
# NODE_ENV=development
# PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/financeOS
# JWT_SECRET=replace-with-a-long-random-string-min-32-chars
# JWT_EXPIRES_IN=7d
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
