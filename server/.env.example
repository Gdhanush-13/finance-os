# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/finance-os)
MONGO_URI=mongodb://127.0.0.1:27017/finance-os

# Auth — access token is short-lived; refresh token renews it silently
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
